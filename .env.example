# Prophet 21 (read-only) connection used for customer / contact lookups
P21_SERVER=sql19
P21_DATABASE=Prophet21
P21_USER=
P21_PASSWORD=
P21_DRIVER=ODBC Driver 17 for SQL Server
# Optional: restrict customer search to one P21 company id
P21_COMPANY_ID=

# Forge (app storage: schema RepairEval)
FORGE_SERVER=sql19
FORGE_DATABASE=Forge
FORGE_SCHEMA=RepairEval
FORGE_USER=
FORGE_PASSWORD=

# Photos live in <PHOTO_FS_ROOT>\R36000\R36169\Photos inside the repair's drawing folder
# (root = the Dwgs share; use the UNC path, not the N: letter). data/test_dwgs for local tests.
PHOTO_FS_ROOT=\\eha-serv.ifp.eha\data\Dwgs

# Windows AD sign-in (mrwuss/auth-middleware). Browsers prompt for domain credentials, then a signed cookie.
AUTH_ENABLED=true            # false = dev mode, every request is AUTH_DEV_USER
AUTH_DOMAIN=IFP-EHA
AUTH_GROUP=                  # AD security group required to use the app (blank = any domain user)
AUTH_COOKIE_SECURE=true      # false only while testing over plain http
AUTH_COOKIE_SECRET=          # blank = generated once into data/auth_cookie_secret; set explicitly for multi-server
AUTH_DEV_USER=dev-user
