# Prophet 21 (read-only) connection used for customer / contact lookups
P21_SERVER=sql19
P21_DATABASE=Prophet21
P21_USER=
P21_PASSWORD=
P21_DRIVER=ODBC Driver 17 for SQL Server
# Optional: restrict customer search to one P21 company id
P21_COMPANY_ID=

# Forge (app storage: schema RepairEval)
FORGE_SERVER=sql19
FORGE_DATABASE=Forge
FORGE_SCHEMA=RepairEval
FORGE_USER=
FORGE_PASSWORD=

# Photo bytes: fs = <PHOTO_FS_ROOT>\R36000\R36169\Photos\<file>.jpg inside the repair's
# drawing folder (root = the Dwgs share; use the UNC path, not the N: letter), db = in Forge
PHOTO_STORE=fs
PHOTO_FS_ROOT=\\eha-serv.ifp.eha\data\Dwgs
